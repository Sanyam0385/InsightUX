{
  "name": "insightux-browser",
  "version": "1.0.0",
  "description": "InsightUX Gaze & Mouse Analysis Browser",
  "author": "InsightUX Team",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.insightux.browser",
    "productName": "InsightUXBrowser",
    "win": {
      "target": "nsis"
    },
    "files": [
      "**/*"
    ],
    "asarUnpack": [
      "python_backend/**/*"
    ]
  }
}
